# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Shared dashboard password
DASHBOARD_PASSWORD=change-me-strong-password

# Random secret for signing session cookies (min 16 chars)
SESSION_SECRET=replace-with-long-random-string

# Protects /api/cron/check — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-long-random-string

# Gmail SMTP (use an App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com
ALERT_EMAIL=you@gmail.com

# Status digest email interval (1 = every minute for testing, 60 = hourly)
STATUS_EMAIL_INTERVAL_MINUTES=1

# Web Push (mobile popup alerts) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# Used for password-reset links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
